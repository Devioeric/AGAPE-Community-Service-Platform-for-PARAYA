        <mxCell id="ann2" value="1.  Scan QR (officer&#39;s screen) &#8594; opens this page with code prefilled  &#8594; auto-submits" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="460" height="40" as="geometry"/></mxCell>
