        <mxCell id="vh" value="If the code expires, just type the next one." style="text;html=1;align=center;verticalAlign=top;spacingTop=440;fontSize=10;fontStyle=2;fontColor=#000;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="500" height="22" as="geometry"/></mxCell>
