        <mxCell id="s2tit" value="Health Caravan @ Lolomboy &#8212; Mang Pedro&apos;s diabetes follow-through" style="text;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="180" width="680" height="22" as="geometry"/></mxCell>
        <mxCell id="s2body" value="During the April caravan, Mang Pedro (62, retired) was screened with HbA1c 8.4 &#8212; previously undiagnosed type 2 diabetes. Referred to Bocaue RHU same day for metformin start. PARAYA volunteer follow-up after 30 days: now reading 6.9, walking 30 min daily, daughter trained on insulin protocol." style="text;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=72;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="180" width="680" height="120" as="geometry"/></mxCell>
        <mxCell id="s2p" value="Program: Health Caravan @ Lolomboy   &#183;   Recorded 2026-05-08   &#183;   Pre/post comparison attached" style="text;html=1;align=left;verticalAlign=top;spacingLeft=16;fontSize=9;fontStyle=2;fontColor=#000;" vertex="1" parent="1"><mxGeometry x="900" y="372" width="680" height="20" as="geometry"/></mxCell>
        <mxCell id="s2a" value="[ View full case study ]  [ Edit ]  [ Schedule 6-month follow-up ]  [ &#128465; ]" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=10;fontStyle=2;fontColor=#000;" vertex="1" parent="1"><mxGeometry x="900" y="410" width="680" height="24" as="geometry"/></mxCell>
        <mxCell id="s3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;" vertex="1" parent="1"><mxGeometry x="240" y="470" width="640" height="270" as="geometry"/></mxCell>
