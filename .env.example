# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (never commit real values)
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Phase 1 stays off until clone/RLS/privacy/operational gates pass
AGAPE_PROFILING_V2_ENABLED=false

# Phase 2 dark-launch gates. Keep false until the Phase 1 release gate and the
# corresponding database component mode have both been approved.
AGAPE_PARTNER_REGISTRY_V2_ENABLED=false
AGAPE_HISTORICAL_PROGRAMS_V2_ENABLED=false
AGAPE_PROPOSALS_V2_ENABLED=false
AGAPE_PROGRAM_FINANCE_V2_ENABLED=false
AGAPE_EXTERNAL_CONTACT_EMAIL_ENABLED=false
AGAPE_LEGACY_ACCOUNT_SUSPENSION_ENABLED=false
