        <mxCell id="s1qi" value="&#10077;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=44;fontColor=#000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="220" width="60" height="60" as="geometry"/></mxCell>
        <mxCell id="s1q" value="Dahil sa Brigada Eskwela, hindi na kailangan kong umutang para sa school supplies ng tatlo kong anak. Hindi pa nakikita ng mga bata na may mga taong tulad ninyo na tumutulong &#8212; nakakapagbigay ito ng pag-asa." style="text;html=1;align=left;verticalAlign=top;spacingLeft=80;spacingTop=10;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="240" y="220" width="600" height="120" as="geometry"/></mxCell>
        <mxCell id="s1m" value="&#8212; Aling Marites C., parent of 3 &#183; Brgy Lolomboy" style="text;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=2;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="346" width="600" height="20" as="geometry"/></mxCell>
