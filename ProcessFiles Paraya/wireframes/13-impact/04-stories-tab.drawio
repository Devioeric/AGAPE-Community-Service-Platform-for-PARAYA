        <mxCell id="s3tit" value="ICT Skills Pilot &#8212; Cohort 1 (12 students)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="470" width="640" height="22" as="geometry"/></mxCell>
        <mxCell id="s3pre" value="BEFORE: 9 of 12 had never opened a spreadsheet; 4 had never used email; avg confidence rating 2.1/10." style="text;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=72;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="240" y="470" width="640" height="44" as="geometry"/></mxCell>
        <mxCell id="s3post" value="AFTER (8 weeks): 12/12 can compose email + create basic spreadsheet; 7/12 enrolled in TESDA cert track; avg 7.4/10 confidence." style="text;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=128;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="240" y="470" width="640" height="56" as="geometry"/></mxCell>
        <mxCell id="s3del" value="Delta: +5.3 confidence avg &#183; 58% downstream enrollment &#183; 0 dropouts" style="text;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=196;fontSize=10;fontStyle=1;fontColor=#000;" vertex="1" parent="1"><mxGeometry x="240" y="470" width="640" height="22" as="geometry"/></mxCell>
