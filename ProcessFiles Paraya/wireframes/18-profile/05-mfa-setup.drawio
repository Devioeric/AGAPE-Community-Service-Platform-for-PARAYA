        <mxCell id="vt" value="Step-by-step" style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="500" height="22" as="geometry"/></mxCell>
        <mxCell id="v1" value="1.  Install an authenticator app on your phone (Google Auth, Authy, 1Password)." style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=48;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="500" height="44" as="geometry"/></mxCell>
        <mxCell id="v2" value="2.  Tap &#8220;+&#8221; or &#8220;Add account&#8221; &#8594; &#8220;Scan a QR code&#8221;." style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=100;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="500" height="44" as="geometry"/></mxCell>
        <mxCell id="v3" value="3.  Point your camera at the QR on the left." style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=152;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="500" height="44" as="geometry"/></mxCell>
        <mxCell id="v4" value="4.  Your app will start showing a 6-digit code that changes every 30s." style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=204;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="500" height="44" as="geometry"/></mxCell>
        <mxCell id="v5" value="5.  Enter that code below to confirm." style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=256;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="500" height="44" as="geometry"/></mxCell>
        <mxCell id="vc" value="Confirmation code from the app *" style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=310;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="500" height="22" as="geometry"/></mxCell>
