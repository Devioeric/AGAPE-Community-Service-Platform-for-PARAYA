        <mxCell id="r3b" value="Salamat po Officer Maria! Naks naman.. Para sa 2027 prep: pwede po ako mag-coordinate sa 3 sitios kong dating sumama. May 12 mothers na nag-volunteer help with crowd next year." style="text;html=1;align=left;verticalAlign=top;spacingLeft=80;spacingTop=64;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="810" width="1340" height="60" as="geometry"/></mxCell>
