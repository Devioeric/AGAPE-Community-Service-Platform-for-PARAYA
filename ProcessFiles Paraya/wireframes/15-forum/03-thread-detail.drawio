        <mxCell id="r1r" value="Barangay Captain" style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=38;fontSize=9;fontStyle=2;fontColor=#000;" vertex="1" parent="1"><mxGeometry x="296" y="490" width="400" height="20" as="geometry"/></mxCell>
        <mxCell id="r1t" value="2 days ago" style="text;html=1;align=right;verticalAlign=top;spacingRight=20;spacingTop=18;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="900" y="490" width="680" height="20" as="geometry"/></mxCell>
        <mxCell id="r1b" value="Salamat sa update Maria! Confirming: water stations are a must &#8212; we lost an hour managing the queue last year. Also, Lolomboy Elem can host load-in Friday afternoon if you want. I&apos;ll coordinate with Principal Gonzaga." style="text;html=1;align=left;verticalAlign=top;spacingLeft=80;spacingTop=64;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="490" width="1340" height="60" as="geometry"/></mxCell>
