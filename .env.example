# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (never commit real values)
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Phase 1 stays off until clone/RLS/privacy/operational gates pass
AGAPE_PROFILING_V2_ENABLED=false

# Phase 2 dark-launch gates. Keep false until the Phase 1 release gate and the
# corresponding database component mode have both been approved.
AGAPE_PARTNER_REGISTRY_V2_ENABLED=false
AGAPE_HISTORICAL_PROGRAMS_V2_ENABLED=false
AGAPE_PROPOSALS_V2_ENABLED=false
AGAPE_PROGRAM_FINANCE_V2_ENABLED=false
AGAPE_EXTERNAL_CONTACT_EMAIL_ENABLED=false
AGAPE_VOLUNTEER_MATCHING_V2_ENABLED=false
AGAPE_PROGRAM_INVITATIONS_V2_ENABLED=false
AGAPE_LEGACY_ACCOUNT_SUSPENSION_ENABLED=false

# Finance integrity verification remains provider-neutral and disabled until a
# reviewed network/relay is configured. Only canonical hashes and non-personal
# proof metadata may leave AGAPE; this feature never processes payments.
AGAPE_FINANCE_INTEGRITY_V1_ENABLED=false
AGAPE_BLOCKCHAIN_ANCHOR_PROVIDER=disabled
AGAPE_BLOCKCHAIN_ANCHOR_ENDPOINT=
AGAPE_BLOCKCHAIN_ANCHOR_API_KEY=
AGAPE_BLOCKCHAIN_NETWORK=
AGAPE_BLOCKCHAIN_CONTRACT_REFERENCE=

# Phase 3 advisory refresh stays disabled until a separate release decision.
# The weekly job only creates deduplicated in-app notices; it never creates or
# transitions a proposal. Keep the mode off outside isolated synthetic tests.
AGAPE_AI_RECOMMENDATION_AUTOMATION_ENABLED=false
AGAPE_AI_RECOMMENDATION_AUTOMATION_MODE=off
