{
  "name": "agape",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test",
    "test:release-gate": "node scripts/verify-phase1-release-gate.mjs",
    "test:phase2-release-gate": "node scripts/verify-phase2-release-gate.mjs",
    "release:inclusion-manifest": "node scripts/build-release-inclusion-manifest.mjs",
    "release:stage-inclusion": "node scripts/stage-release-inclusion.mjs",
    "db:inventory": "node scripts/audit-migration-inventory.mjs",
    "db:schema-equivalence": "node scripts/verify-schema-equivalence.mjs",
    "db:validate-evidence": "node scripts/validate-authoritative-evidence.mjs",
    "test:db:preflight": "node scripts/run-local-database-gates.mjs --preflight",
    "test:db:replay": "node scripts/run-local-database-gates.mjs --replay-only",
    "test:db:gates": "node scripts/run-local-database-gates.mjs --all",
    "test:e2e": "next build && node scripts/run-playwright.mjs",
    "test:e2e:list": "playwright test --list",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@base-ui/react": "^1.4.1",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-table": "^8.21.3",
    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-day-picker": "^10.0.0",
    "react-dom": "^18",
    "react-hook-form": "^7.75.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "supabase": "^2.114.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
