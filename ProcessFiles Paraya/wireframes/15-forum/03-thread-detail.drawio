        <mxCell id="r2t" value="yesterday" style="text;html=1;align=right;verticalAlign=top;spacingRight=20;spacingTop=18;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="900" y="650" width="680" height="20" as="geometry"/></mxCell>
        <mxCell id="r2b" value="That sign-in spreadsheet @MariaSantos mentioned: I&apos;ve cleaned it up &#8212; turned it into a template. Uploaded to: /shared/templates/brigada-signin-2027.xlsx. CTE volunteers can reuse for any future student-count event." style="text;html=1;align=left;verticalAlign=top;spacingLeft=80;spacingTop=64;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="650" width="1340" height="60" as="geometry"/></mxCell>
