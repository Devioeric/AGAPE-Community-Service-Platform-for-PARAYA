        <mxCell id="rph2" value="PARAYA Office &#183; DYCI Bocaue &#183; reporting period: 2026-01-01 to 2026-03-31" style="text;html=1;align=left;verticalAlign=top;spacingLeft=40;spacingTop=94;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="580" y="174" width="1000" height="22" as="geometry"/></mxCell>
        <mxCell id="rpb1" value="During Q1 2026, PARAYA delivered 12 community programs across 8 partner barangays, with the strongest concentrations in Lolomboy, Bambang, and Caingin. A total of 142 active volunteer-students from DYCI contributed 3,486 service hours, an 18% increase versus Q1 2025, driven primarily by Brigada Eskwela and the Q1 Health Caravan series." style="text;html=1;align=left;verticalAlign=top;spacingLeft=40;spacingTop=140;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="174" width="1000" height="80" as="geometry"/></mxCell>
        <mxCell id="rpb2" value="Donation intake reached &#8369; 1.25M with an 87% same-quarter distribution rate. Corporate donors (45%) led intake, with SM Foundation contributing 28% of the total. Government share grew from 8% to 20% after the LGU Bocaue MOA signed in February." style="text;html=1;align=left;verticalAlign=top;spacingLeft=40;spacingTop=240;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="174" width="1000" height="80" as="geometry"/></mxCell>
        <mxCell id="rpcal" value="&#10077; Highlights" style="text;html=1;align=left;verticalAlign=top;spacingLeft=40;spacingTop=340;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="174" width="1000" height="22" as="geometry"/></mxCell>
        <mxCell id="rph3" value="&#8226;  Brigada Eskwela 2026 reached 820 students (target 600)." style="text;html=1;align=left;verticalAlign=top;spacingLeft=40;spacingTop=370;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="174" width="1000" height="22" as="geometry"/></mxCell>
        <mxCell id="rph4" value="&#8226;  Health Caravan @ Lolomboy screened 340 individuals; 42 new diagnoses; 31 RHU referrals completed." style="text;html=1;align=left;verticalAlign=top;spacingLeft=40;spacingTop=392;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="174" width="1000" height="22" as="geometry"/></mxCell>
        <mxCell id="rph5" value="&#8226;  4 of 4 priority SDGs are progressing on plan; SDG 4 already at 75% of annual target." style="text;html=1;align=left;verticalAlign=top;spacingLeft=40;spacingTop=414;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="174" width="1000" height="22" as="geometry"/></mxCell>
