        <mxCell id="ma" value="[ &#9737; Subscribe ]   [ &#128204; Pin ]   [ &#9776; More &#9662; ]" style="text;html=1;align=right;verticalAlign=middle;spacingRight=20;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="900" y="134" width="700" height="22" as="geometry"/></mxCell>
