        <mxCell id="qrart" value="&#9632;&#9633;&#9632;&#9633;  &#9632;  &#9633;&#9632;&#9633;&#10;&#9633;&#9632;&#9633;&#9632;  &#9633;  &#9632;&#9633;&#9632;&#10;&#9632;&#9633;&#9632;&#9633;  &#9632;  &#9633;&#9632;&#9633;&#10;        (QR placeholder)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontFamily=Courier New;fontColor=#000;" vertex="1" parent="1"><mxGeometry x="540" y="306" width="300" height="300" as="geometry"/></mxCell>
