        <mxCell id="f5" value="Inventory clerk &#9662;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;align=left;spacingLeft=14;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="330" width="400" height="36" as="geometry"/></mxCell>
        <mxCell id="f6l" value="What did you do? *" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=20;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="376" width="400" height="22" as="geometry"/></mxCell>
        <mxCell id="f6" value="Counted incoming kit donations from SM Foundation, sorted by grade level, helped 4 other volunteers stage them at the gym for Saturday distribution. Logged the count in the shared spreadsheet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="402" width="860" height="80" as="geometry"/></mxCell>
        <mxCell id="f7l" value="Photo evidence (optional)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=20;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="492" width="400" height="22" as="geometry"/></mxCell>
        <mxCell id="f7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;dashed=1;" vertex="1" parent="1"><mxGeometry x="260" y="518" width="860" height="120" as="geometry"/></mxCell>
        <mxCell id="f7t" value="[ Tap to upload from gallery or take photo ]&#10;&#10;Recommended: photo of the activity site or attendance sheet." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="260" y="518" width="860" height="120" as="geometry"/></mxCell>
        <mxCell id="f8l" value="Signature / witness (optional)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=20;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="648" width="400" height="22" as="geometry"/></mxCell>
        <mxCell id="f8" value="Officer Maria S. confirmed in person, no signature needed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;align=left;spacingLeft=14;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="674" width="860" height="36" as="geometry"/></mxCell>
        <mxCell id="bcan" value="[ CANCEL ]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="738" width="180" height="40" as="geometry"/></mxCell>
        <mxCell id="bdraft" value="[ SAVE DRAFT ]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="738" width="180" height="40" as="geometry"/></mxCell>
        <mxCell id="bsubmit" value="[ SUBMIT FOR APPROVAL ]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000;strokeColor=#000;fontColor=#fff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="738" width="0" height="40" as="geometry"/></mxCell>
        <mxCell id="bsub2" value="[ SUBMIT FOR APPROVAL ]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000;strokeColor=#000;fontColor=#fff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="738" width="280" height="40" as="geometry"/></mxCell>
        <mxCell id="rp" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="420" height="500" as="geometry"/></mxCell>
        <mxCell id="rpt" value="Tips" style="text;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="300" height="28" as="geometry"/></mxCell>
        <mxCell id="t1" value="&#9679;  Log within 7 days of the activity. Older entries need officer override." style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=44;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="420" height="40" as="geometry"/></mxCell>
        <mxCell id="t2" value="&#9679;  Be specific about what you did &#8212; one or two sentences is enough." style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=88;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="420" height="40" as="geometry"/></mxCell>
        <mxCell id="t3" value="&#9679;  Photo evidence makes approval faster, especially for >4 hour logs." style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=132;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="420" height="40" as="geometry"/></mxCell>
        <mxCell id="t4" value="&#9679;  Save as DRAFT if you want to add more details later." style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=176;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="420" height="40" as="geometry"/></mxCell>
        <mxCell id="t5" value="&#9679;  Submitted logs appear in My Hours as ( pending ) until officer approves." style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=220;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="420" height="40" as="geometry"/></mxCell>
        <mxCell id="rec" value="Your last 3 logs:" style="text;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=290;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="400" height="22" as="geometry"/></mxCell>
        <mxCell id="rec1" value="May 12  &#183;  Health Caravan @ Lolomboy  &#183;  4h  &#183;  ( approved )" style="text;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=320;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="420" height="22" as="geometry"/></mxCell>
        <mxCell id="rec2" value="May 10  &#183;  ICT Skills Pilot  &#183;  2h  &#183;  ( pending )" style="text;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=346;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="420" height="22" as="geometry"/></mxCell>
