        <mxCell id="opn" value="Officer Maria Santos" style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=22;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="190" width="500" height="22" as="geometry"/></mxCell>
        <mxCell id="opnr" value="PARAYA Associate" style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=44;fontSize=10;fontStyle=2;fontColor=#000;" vertex="1" parent="1"><mxGeometry x="300" y="190" width="500" height="22" as="geometry"/></mxCell>
        <mxCell id="opt" value="May 10, 2026 &#183; 14:22" style="text;html=1;align=right;verticalAlign=top;spacingRight=20;spacingTop=22;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="900" y="190" width="660" height="22" as="geometry"/></mxCell>
        <mxCell id="opb1" value="Now that Brigada Eskwela 2026 is wrapped, sharing the highlights + things to improve. Numbers: 820 students reached (vs target 600), 4 elementary schools, 46 volunteers, 412 vol-hours. SM Foundation funded 500 kits, parishes added 320 more." style="text;html=1;align=left;verticalAlign=top;spacingLeft=80;spacingTop=82;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="190" width="1340" height="60" as="geometry"/></mxCell>
        <mxCell id="opb2" value="What went well: (1) Pre-positioning supplies at DepEd district office Friday saved Saturday morning chaos. (2) Mother Leader Aida M. coordinated Lolomboy crowd flow brilliantly. (3) CCS volunteers built a sign-in spreadsheet on the fly &#8212; saved us during count reconciliation." style="text;html=1;align=left;verticalAlign=top;spacingLeft=80;spacingTop=158;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="190" width="1340" height="60" as="geometry"/></mxCell>
        <mxCell id="opb3" value="What to fix for 2027: (1) Need water stations at every distribution corner. (2) Print parent FAQ in Tagalog &#8212; English-only confused some. (3) Bambang Elem needs an earlier load-in slot &#8212; they share gate with grade school class." style="text;html=1;align=left;verticalAlign=top;spacingLeft=80;spacingTop=238;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="190" width="1340" height="60" as="geometry"/></mxCell>
        <mxCell id="opb4" value="@Brgy Capt Lolomboy @Officer Joseph &#8212; would love your write-up too. Locking commitments by next Friday so we can hit Q3 planning." style="text;html=1;align=left;verticalAlign=top;spacingLeft=80;spacingTop=318;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="240" y="190" width="1340" height="60" as="geometry"/></mxCell>
        <mxCell id="opr" value="&#10084; 14    &#128077; 8    &#128591; 5" style="text;html=1;align=left;verticalAlign=top;spacingLeft=80;spacingTop=388;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="190" width="500" height="22" as="geometry"/></mxCell>
        <mxCell id="opa" value="[ Reply ]   [ Edit ]   [ Add to report sources ]" style="text;html=1;align=right;verticalAlign=top;spacingRight=20;spacingTop=388;fontSize=11;fontStyle=2;fontColor=#000;" vertex="1" parent="1"><mxGeometry x="900" y="190" width="680" height="22" as="geometry"/></mxCell>
