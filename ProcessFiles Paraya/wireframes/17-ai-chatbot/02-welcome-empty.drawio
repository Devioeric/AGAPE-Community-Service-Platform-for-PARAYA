        <mxCell id="su1" value="&#9656; &quot;Draft a thank-you email to SM Foundation for Q1&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;align=left;spacingLeft=14;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="290" width="500" height="38" as="geometry"/></mxCell>
