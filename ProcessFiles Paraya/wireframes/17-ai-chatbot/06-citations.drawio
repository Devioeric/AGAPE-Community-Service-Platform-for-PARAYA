        <mxCell id="a1p1" value="Lolomboy currently has 14 open community needs in the database (last updated 2026-05-12)." style="text;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=44;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="150" width="900" height="22" as="geometry"/></mxCell>
