        <mxCell id="ann5" value="&#8212; Invalid code (typo): &#8220;Code not found.&#8221;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="460" height="22" as="geometry"/></mxCell>
        <mxCell id="ann6" value="&#8212; Expired code: &#8220;This code has expired. Ask the officer to rotate.&#8221;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="460" height="22" as="geometry"/></mxCell>
        <mxCell id="ann7" value="&#8212; Already checked in: &#8220;You&#39;re already on the roster (logged at 2:04 PM).&#8221;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="460" height="22" as="geometry"/></mxCell>
        <mxCell id="ann8" value="&#8212; Not signed up: &#8220;You aren&#39;t signed up for this activity &#8212; tell the officer.&#8221;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="394" width="460" height="22" as="geometry"/></mxCell>
        <mxCell id="anns2" value="Right-pane mockup:" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="160" width="460" height="22" as="geometry"/></mxCell>
        <mxCell id="anns3" value="&#8212; Same /volunteer/check-in page works on tablet and desktop (responsive)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="190" width="600" height="40" as="geometry"/></mxCell>
        <mxCell id="anns4" value="&#8212; Volunteers who arrive without internet can still queue up &#8212; check-in retries on reconnect" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="234" width="600" height="40" as="geometry"/></mxCell>
        <mxCell id="anns5" value="&#8212; Volunteer&#39;s session badge fires on the officer&#39;s &#8220;Checked In&#8221; roster within ~2 seconds" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="278" width="600" height="40" as="geometry"/></mxCell>
        <mxCell id="anns6" value="&#8212; Walks the volunteer back to their dashboard after a 4-second hold" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="322" width="600" height="40" as="geometry"/></mxCell>
